<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Saldo360.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Saldo360.Views"
    Title="Saldo360"
    FlyoutBehavior="Flyout"
    Shell.FlyoutBackgroundColor="White"
    Shell.BackgroundColor="{StaticResource Primary}"
    Shell.ForegroundColor="White"
    Shell.TitleColor="White"
    Shell.TabBarBackgroundColor="White"
    Shell.TabBarForegroundColor="{StaticResource Primary}"
    Shell.TabBarTitleColor="{StaticResource Primary}"
    Shell.TabBarUnselectedColor="{StaticResource Muted}">

    <Shell.Resources>
        <!-- Aparência dos itens do menu lateral: o item selecionado fica verde claro -->
        <Style TargetType="Label" Class="FlyoutItemLabelStyle">
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
        <Style TargetType="Layout" ApplyToDerivedTypes="True" Class="FlyoutItemLayoutStyle">
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="Transparent" />
                                <Setter TargetName="FlyoutItemLabel" Property="Label.TextColor" Value="{StaticResource TextDark}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Selected">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{StaticResource PrimarySoft}" />
                                <Setter TargetName="FlyoutItemLabel" Property="Label.TextColor" Value="{StaticResource Primary}" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
    </Shell.Resources>

    <!-- Navegação: Menu lateral (Flyout) -->
    <Shell.FlyoutHeader>
        <VerticalStackLayout BackgroundColor="{StaticResource Primary}" Padding="24,56,24,24" Spacing="4">
            <Label Text="Saldo360" TextColor="White" FontFamily="OpenSansSemibold" FontSize="26" />
            <Label Text="Seu dinheiro, com mais clareza." TextColor="#CFE9DC" FontSize="13" />
        </VerticalStackLayout>
    </Shell.FlyoutHeader>

    <Shell.FlyoutFooter>
        <Label Text="Saldo360 • versão 1.0" Style="{StaticResource MutedLabel}" Margin="24,16" />
    </Shell.FlyoutFooter>

    <!-- As 4 telas principais aparecem no menu lateral (AsMultipleItems)
         e também como abas no menu inferior (Tab) -->
    <FlyoutItem Title="Painel" FlyoutDisplayOptions="AsMultipleItems">
        <ShellContent Title="Início" Icon="tab_home.svg" Route="DashboardPage"
                      ContentTemplate="{DataTemplate views:DashboardPage}" />
        <ShellContent Title="Movimentações" Icon="tab_list.svg" Route="MovementsPage"
                      ContentTemplate="{DataTemplate views:MovementsPage}" />
        <ShellContent Title="Planejamento" Icon="tab_goal.svg" Route="PlanningPage"
                      ContentTemplate="{DataTemplate views:PlanningPage}" />
        <ShellContent Title="Economia" Icon="tab_trend.svg" Route="EconomyPage"
                      ContentTemplate="{DataTemplate views:EconomyPage}" />
    </FlyoutItem>

    <!-- Só existem no menu lateral (item sozinho = sem abas) -->
    <FlyoutItem Title="Simulador" Icon="tab_swap.svg">
        <ShellContent Title="Simulador" Route="SimulatorPage"
                      ContentTemplate="{DataTemplate views:SimulatorPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Dólar x inflação" Icon="tab_chart.svg">
        <ShellContent Title="Dólar x inflação" Route="ComparisonPage"
                      ContentTemplate="{DataTemplate views:ComparisonPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Sobre" Icon="tab_info.svg">
        <ShellContent Title="Sobre" Route="AboutPage"
                      ContentTemplate="{DataTemplate views:AboutPage}" />
    </FlyoutItem>
</Shell>
