<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Saldo360.Views.MovementDetailPage"
             Title="Detalhes"
             Shell.TabBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout x:Name="Root" Padding="20,24" Spacing="16">

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                    <Border BackgroundColor="{StaticResource PrimarySoft}" StrokeThickness="0"
                            StrokeShape="RoundRectangle 32" WidthRequest="64" HeightRequest="64"
                            HorizontalOptions="Center">
                        <Label x:Name="IconLabel" FontSize="30"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label x:Name="DescriptionLabel" FontSize="20" Style="{StaticResource Strong}"
                           HorizontalTextAlignment="Center" />
                    <Label x:Name="AmountLabel" FontSize="30" Style="{StaticResource Strong}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="12" ColumnSpacing="16">
                    <Label Text="Tipo" Style="{StaticResource MutedLabel}" />
                    <Label x:Name="TypeLabel" Grid.Column="1" HorizontalOptions="End" />

                    <Label Grid.Row="1" Text="Categoria" Style="{StaticResource MutedLabel}" />
                    <Label x:Name="CategoryLabel" Grid.Row="1" Grid.Column="1" HorizontalOptions="End" />

                    <Label Grid.Row="2" Text="Data" Style="{StaticResource MutedLabel}" />
                    <Label x:Name="DateLabel" Grid.Row="2" Grid.Column="1" HorizontalOptions="End" />
                </Grid>
            </Border>

            <Button Text="Excluir movimentação" Style="{StaticResource DangerButton}" Clicked="OnDelete" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
